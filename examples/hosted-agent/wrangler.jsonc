{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "juno-hosted-agent",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true }
  // Hub keeps each person's box, thread, daily count and calls.
  // Secrets: wrangler secret put TANGLE_API_KEY | OWNER_PHONE | SETUP_SECRET
}
