{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":dependencyDashboard"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "prConcurrentLimit": 12,
  "prHourlyLimit": 4,
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["security", "dependencies"],
    "minimumReleaseAge": null
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Tangle-published packages share one compatible release train. Immediate updates are limited to non-breaking releases; majors keep the breaking label and the repository release hold.",
      "matchPackageNames": ["@tangle-network/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "agent stack cohort",
      "schedule": ["at any time"],
      "minimumReleaseAge": null
    },
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["breaking"]
    },
    {
      "matchPackageNames": ["typescript", "eslint", "@typescript-eslint/**"],
      "groupName": "TypeScript toolchain"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    }
  ]
}
