{
  "name": "__PACKAGE_NAME__",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "wrangler dev",
    "build": "pnpm run typecheck && pnpm run build:web",
    "build:web": "vite build",
    "deploy": "pnpm run peer-check && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply __PACKAGE_NAME__ --remote",
    "db:migrate:local": "wrangler d1 migrations apply __PACKAGE_NAME__ --local",
    "peer-check": "agent-app-peer-check",
    "signoff": "agent-app-signoff",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tangle-network/agent-app": "__AGENT_APP_VERSION__",
    "@tangle-network/agent-gateway": "0.11.4",
    "@tangle-network/agent-interface": "2.17.0",
    "@tangle-network/agent-runtime": "0.293.0",
    "@tangle-network/sandbox": "0.60.10",
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "viem": "^2.0.0",
    "@tangle-network/brand": "1.11.0",
    "@tangle-network/sandbox-ui": "0.124.0",
    "@tangle-network/ui": "11.17.0",
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@nanostores/react": "1.1.0",
    "nanostores": "1.5.4"
  },
  "peerDependencies": {
    "@tangle-network/agent-eval": ">=0.205.1 <0.206.0",
    "@tangle-network/agent-integrations": ">=0.60.0 <0.61.0"
  },
  "devDependencies": {
    "@tangle-network/agent-eval": "0.205.1",
    "@tangle-network/agent-integrations": "0.60.0",
    "@tangle-network/agent-knowledge": "19.0.1",
    "@cloudflare/workers-types": "^5.20260827.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.1",
    "better-sqlite3": "^12.11.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "4.126.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.2.2",
    "@tailwindcss/postcss": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "postcss": "^8.5.26"
  }
}
