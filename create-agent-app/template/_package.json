  },
  "devDependencies": {
    "@tangle-network/agent-eval": "0.203.0",
    "@tangle-network/agent-integrations": "0.59.0",
    "@tangle-network/agent-interface": "2.15.0",
    "@tangle-network/agent-knowledge": "18.0.0",
