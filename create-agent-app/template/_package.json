  },
  "devDependencies": {
    "@tangle-network/agent-eval": "0.199.1",
    "@tangle-network/agent-integrations": "0.57.0",
    "@tangle-network/agent-interface": "2.14.0",
    "@tangle-network/agent-knowledge": "17.1.10",
    "@tangle-network/agent-runtime": "0.285.0",
    "@tangle-network/sandbox": "0.58.1",
    "@types/node": "^22.20.1",
